# 비밀값은 이 파일이 아닌 Git 제외 대상 .env에 입력합니다.
# 사용자 선택 모델. 실제 사용 가능 여부·응답 시간은 해당 키로 검증합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 현재 코드에는 보조 모델 자동 재시도가 구현되어 있지 않습니다.
GEMINI_FALLBACK_MODEL=

# 서버 실행 시 host/port는 uvicorn CLI 인자로 지정합니다.
PORT=8000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=production

# 공식 액션 서버 기본 주소. 공식 클라이언트·Mock 추가 변경은 진행 중이며 통합 검증이 필요합니다.
ACTION_SERVER_URL=https://gyodong-mall-action.aitop100.org
# 참가 동의 후 발급되는 aitop100_ 접두사의 실제 토큰을 .env에 입력합니다.
ACTION_SERVER_TOKEN=

# 운영 요청 내부 제한 및 SimpleText 후처리 목표
INTERNAL_TIMEOUT_SECONDS=4.5
MAX_RESPONSE_CHARACTERS=480
