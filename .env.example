# ==============================================================================
# 교동마을 산지직송 AI CS 에이전트 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================

# [LLM 엔진 설정]
# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=AIzaSyD-YourGeminiApiKeyHere
# 기본 활용 모델: Gemini Flash Lite 계열 (사용자 지정: gemini-3.5-flash-lite 또는 gemini-2.0-flash-lite)
# 초저지연 및 고효율 응답 속도 최적화
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b

# [서버 구동 설정]
# FastAPI 서비스 구동 포트
PORT=8000
HOST=0.0.0.0
# 디버그 모드 (운영 심사 시 False 설정 권장)
DEBUG=false
ENVIRONMENT=production

# [외부 액션 서버 연동 설정]
# 회원 인증, 주문/배송지 수정, 관리자 에스컬레이션 티켓 연동 서버
ACTION_SERVER_URL=https://api.gyodong-live.internal/v1
ACTION_SERVER_TOKEN=gyodong_secret_action_token_2037_ax

# [타임아웃 및 가드레일 설정]
# 대회 60초 타임아웃 규정 대비 LLM 및 액션 호출 내부 타임아웃 (초 단위)
INTERNAL_TIMEOUT_SECONDS=45
# 카카오 SimpleText 말풍선 단일 응답 글자수 제한 (대회 500자 제한 대비 안전선)
MAX_RESPONSE_CHARACTERS=480
